# Copy this to .env.local and fill in real values for local dev.
# NEVER commit .env.local.

# SQLite database file path (relative to project root)
DATABASE_URL=./data/dev.db

# Key Encryption Key (KEK) - 32 bytes, base64-encoded.
# Used ONLY to encrypt/decrypt each workspace's per-workspace Data Encryption Key (DEK).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEK_BASE64=

# Session cookie signing secret (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Optional: set to "true" to disable secure-only cookies during local http dev
INSECURE_COOKIES=true
